        <mxCell id="NnLTh8Sp8L4dDNirga1Q-1" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;verticalAlign=top;" value="HOST&lt;br&gt;VS Code" vertex="1">
          <mxGeometry height="160" width="160" x="-40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="NnLTh8Sp8L4dDNirga1Q-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;" value="CLIENT&lt;br&gt;GitHub Copilot" vertex="1">
          <mxGeometry height="60" width="120" x="-20" y="130" as="geometry" />
        </mxCell>
        <mxCell id="NnLTh8Sp8L4dDNirga1Q-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="SERVER" vertex="1">
          <mxGeometry height="60" width="120" x="240" y="130" as="geometry" />
        </mxCell>
        <mxCell id="NnLTh8Sp8L4dDNirga1Q-6" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;div&gt;HOST manages the LLM. It either hosts the LLM or connects to it.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;CLIENT just connects to the SERVER&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;SERVER is unaware of model, it just exposes actions, resources, prompt_templates&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="160" x="-320" y="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

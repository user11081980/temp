        <mxCell id="cSOjJ_7WnkXmkzBxXew3-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="In this use case, there are a few indexes to be queried. An agentic orchestrator is needed to decide which index to go and query. The agentic orchestrator plans subqueries, runs them in parallel, then returns the grounding text chunks and a view of what it did. Alternatively, the agentic orchestrator can return natural language responses, a feature called Answer Synthesis." vertex="1">
          <mxGeometry height="200" width="200" x="320" y="40" as="geometry" />
        </mxCell>
        <mxCell id="cSOjJ_7WnkXmkzBxXew3-3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="We create a knowledge base that points at multiple indexes and connect it to a model." vertex="1">
          <mxGeometry height="200" width="200" x="600" y="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="5tR8eMGha35eiLXBTC72" name="Semantic Kernel. Function Calling">
    <mxGraphModel dx="1665" dy="838" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="0sml5FvaPpi0e-A2cqdO-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="484" width="1300" x="80" y="120" as="geometry" />
        </mxCell>
        <mxCell id="c4xOGzChEnjynyv-ijSV-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;title: Semantic Kernel&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Semantic Kernel -&amp;gt; LLM: prompt and function definitions&lt;/div&gt;&lt;div&gt;LLM --&amp;gt; Semantic Kernel: request to function-calling with parameters&lt;/div&gt;&lt;div&gt;Semantic Kernel -&amp;gt; Function: function-calling with parameters&lt;/div&gt;&lt;div&gt;Function --&amp;gt; Semantic Kernel:&lt;/div&gt;&lt;div&gt;Semantic Kernel -&amp;gt; LLM: prompt and function results&lt;/div&gt;&lt;div&gt;LLM --&amp;gt; Semantic Kernel: generated response&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="400" x="80" y="640" as="geometry" />
        </mxCell>
        <mxCell id="uS8g44fw3jGtGXl6gr8--1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;div&gt;Function calling is a feature of LLMs, where LLMs determines what external functions should be called with what parameters.&lt;br&gt;&lt;br&gt;The LLM does not call the function directly. Instead, it instructs the client application to call it.&lt;br&gt;&lt;br&gt;The client then provides the prompt and function response to the LLM, which generates a response.&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="240" x="560" y="640" as="geometry" />
        </mxCell>
        <mxCell id="UDxguRBSp8SS7RHZn3ju-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="Semantic Kernel is an orchestrator between the client application and the LLM. It competes with LangChain.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In the context of Semantic Kernel, a function is actually a plugin. Semantic Kernel can connect to MCP servers through the MCPStdioPlugin and MCPStreamableHttpPlugin types. MCP merely exposes tools and resources but lacks of any intelligence whatsoever, therefore Semantic Kernel is still necessary for orchestration.&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="240" x="880" y="640" as="geometry" />
        </mxCell>
        <mxCell id="7xQiUZGcLGrT4XxqkAQR-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="The Semantic Kernel component is typically deployed to an Azure App Service (or Azure Function in EDA)." vertex="1">
          <mxGeometry height="200" width="240" x="1200" y="640" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="TJs8VT9xox-zyY_cCGVl" name="Semantic Kernel. ChatCompletion">
    <mxGraphModel dx="2065" dy="1290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="y3F3hf1Ldrot-30ICsZO-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="486" width="1300" x="-400" y="-160" as="geometry" />
        </mxCell>
        <mxCell id="y3F3hf1Ldrot-30ICsZO-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;Event Processor -&amp;gt; SQL Database: retrieve client data&lt;/div&gt;&lt;div&gt;SQL Database --&amp;gt; Event Processor:&lt;/div&gt;&lt;div&gt;Event Processor -&amp;gt; SQL Database: retrieve AI settings&lt;/div&gt;&lt;div&gt;Event Processor -&amp;gt; Event Processor: prepare AI request&lt;/div&gt;&lt;div&gt;Event Processor -&amp;gt; AI Chat Proxy: generate summary&lt;/div&gt;&lt;div&gt;AI Chat Proxy -&amp;gt; Azure OpenAI: generate summary&lt;/div&gt;&lt;div&gt;Azure OpenAI --&amp;gt; AI Chat Proxy:&lt;/div&gt;&lt;div&gt;AI Chat Proxy --&amp;gt; Event Processor:&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="400" x="-400" y="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="SRj0TZI_7VnZV2SRP823" name="Semantic Kernel. RAG">
    <mxGraphModel dx="2065" dy="838" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_4Be3k3No8DEjtI5_MU-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="At a high level, Semantic Kernel performs these steps in a RAG implementation:&lt;br&gt;&lt;br&gt;1. Receive a question&lt;br&gt;2. Call Azure AI Search via a vector / hybrid query&lt;br&gt;3. Build a prompt that includes the retrieved context&lt;br&gt;4. Call the chat model&lt;br&gt;5. Return a grounded answer plus optional citations or metadata" vertex="1">
          <mxGeometry height="200" width="270" y="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="q-ljUYgsPYMSq9XN2oMv" name="MCP">

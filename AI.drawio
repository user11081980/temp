        <mxCell id="1FbOqA_suXgTDa79VxNz-3" value="Add skills&lt;br&gt;Create and customize index&lt;br&gt;Schedule crawling, only pulls new data" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1">

          <mxGeometry height="180" width="400" x="-280" y="520" as="geometry" />
        </mxCell>
        <mxCell id="J5jL0vo97nnoDl0BAgjc-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="Many&lt;br/&gt;people think that a sufficiently long context is sufficient replacement for&lt;br/&gt;RAG." vertex="1">
          <mxGeometry height="160" width="200" x="160" y="520" as="geometry" />
